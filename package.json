{
  "name": "vos-roof-studio",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build && node scripts/finalize-export.mjs",
    "start": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/tests/*.test.ts",
    "test:browser": "node scripts/qa.mjs",
    "test:a11y": "node scripts/qa-accessibility.mjs",
    "test:extended": "node scripts/qa-extended.mjs",
    "test:presentation": "node scripts/qa-presentation.mjs",
    "test:mobile": "node scripts/qa-mobile.mjs",
    "docs:screenshots": "node scripts/capture-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "assets": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
